{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeProjectExtractorInput",
  "type": "object",
  "required": [
    "document_id",
    "project_mode",
    "chunks"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "source_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_mode": {
      "type": "string",
      "enum": ["single_project", "multi_project"]
    },
    "project_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "chunk_id",
          "text"
        ],
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "chunk_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "page": {
            "type": [
              "integer",
              "null"
            ]
          },
          "page_start": {
            "type": [
              "integer",
              "null"
            ]
          },
          "page_end": {
            "type": [
              "integer",
              "null"
            ]
          },
          "section_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "char_start": {
            "type": [
              "integer",
              "null"
            ]
          },
          "char_end": {
            "type": [
              "integer",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
