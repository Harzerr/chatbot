{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeProjectExtractionResult",
  "type": "object",
  "required": [
    "document_id",
    "projects"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project_id",
          "project_name",
          "key_points"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "project_name": {
            "type": "string"
          },
          "time_range": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "engineering_challenge": {
            "type": ["string", "null"]
          },
          "design_rationale": {
            "type": ["string", "null"]
          },
          "tech_stack": {
            "type": "array",
            "items": {"type": "string"}
          },
          "industrial_roles": {
            "type": "array",
            "items": {"type": "object", "additionalProperties": true}
          },
          "source_chunk_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "key_points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "point_id",
                "category",
                "title",
                "normalized_fact",
                "resume_bullet",
                "confidence",
                "evidence_chunks"
              ],
              "properties": {
                "point_id": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "background",
                    "goal",
                    "role",
                    "responsibility",
                    "architecture",
                    "tech_stack",
                    "implementation",
                    "agent_workflow",
                    "data_processing",
                    "memory_context",
                    "tool_calling",
                    "evaluation",
                    "optimization",
                    "difficulty",
                    "result",
                    "metric",
                    "deployment",
                    "other"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "normalized_fact": {
                  "type": "string"
                },
                "resume_bullet": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence_chunks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "required": [
                      "chunk_id",
                      "quote",
                      "support"
                    ],
                    "properties": {
                      "chunk_id": {
                        "type": "string"
                      },
                      "quote": {
                        "type": "string"
                      },
                      "support": {
                        "type": "string"
                      },
                      "page": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "char_start": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "char_end": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unassigned_chunks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
